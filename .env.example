# Copy to .env and adjust to your backend server.
#
#   cp .env.example .env
#

# Backend API
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Authentication
# VITE_API_KEY is used for project-scoped API calls (client authentication)
# VITE_MANAGEMENT_KEY is used for admin/management endpoints (dashboard authentication)
# Use ONE of them, or both for different purposes
VITE_API_KEY=sk_live_your_api_key_here
VITE_MANAGEMENT_KEY=hl_mgmt_your_management_key_here

# Development
# Set to true to use simulated data (no backend required)
# Set to false to use real backend API
VITE_SIMULATED=false
